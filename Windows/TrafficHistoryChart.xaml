<UserControl x:Class="Byway.TrafficHistoryChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Byway">
    <UserControl.Resources>
        <DrawingBrush x:Key="MissingTraffic" Viewport="0,0,5,5" ViewportUnits="Absolute"
                      Viewbox="0,0,5,5" ViewboxUnits="Absolute" TileMode="Tile" Opacity="0.45">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 0,5 L 5,0 M -5,5 L 5,-5 M 0,10 L 10,0">
                    <GeometryDrawing.Pen><Pen Brush="Gray" Thickness="1"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="UploadTraffic" Color="#0E9383"/>
        <Style x:Key="TrafficSlot" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Highlight" Background="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Highlight" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Canvas x:Name="Scale" Margin="0,0,6,0" IsHitTestVisible="False"/>
        <Grid Grid.Column="1" x:Name="Plot">
            <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1"/>
            <UniformGrid Rows="3" IsHitTestVisible="False" Opacity="0.7">
                <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,1,0,0"/>
            </UniformGrid>
            <ListBox x:Name="Bars" Padding="0" BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource TrafficSlot}" SelectionChanged="BarSelectionChanged"
                     PreviewKeyDown="OnBarKeyDown" AutomationProperties.AutomationId="TrafficHistoryBars"
                     AutomationProperties.Name="{local:Loc '分时用量'}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
        <Canvas x:Name="Ticks" Grid.Column="1" Grid.Row="1" SizeChanged="TicksSizeChanged" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
