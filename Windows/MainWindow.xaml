<Window x:Class="Byway.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Byway"
        Title="Byway" Icon="Byway.ico" Width="1056" Height="660" MinWidth="790" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Height="18" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" CornerRadius="1.5" Visibility="Collapsed"
                                        Background="{DynamicResource AccentButtonBackground}"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="180" MinWidth="144" MaxWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="440"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid Margin="12,18,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="9,2,0,20">
                    <Image Source="Byway.ico" Width="28" Height="28" Margin="0,0,9,0"/>
                    <TextBlock Text="Byway" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox x:Name="Navigation" Grid.Row="1" SelectedIndex="0" SelectionChanged="NavigationChanged"
                         Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource SidebarItem}"
                         AutomationProperties.Name="主导航" AutomationProperties.AutomationId="WorkspaceNavigation">
                    <ListBoxItem AutomationProperties.Name="节点" AutomationProperties.AutomationId="NavNodes">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SidebarGlyph}" Text="&#xE774;"/><TextBlock Text="节点"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="配置" AutomationProperties.AutomationId="NavConfig">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SidebarGlyph}" Text="&#xE8A5;"/><TextBlock Text="配置"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="私网" AutomationProperties.AutomationId="NavPrivateNetwork">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SidebarGlyph}" Text="&#xE839;"/><TextBlock Text="私网"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="统计" AutomationProperties.AutomationId="NavStats">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SidebarGlyph}" Text="&#xE9D9;"/><TextBlock Text="统计"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="设置" AutomationProperties.AutomationId="NavSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SidebarGlyph}" Text="&#xE713;"/><TextBlock Text="设置"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="AI" AutomationProperties.AutomationId="NavAi">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource SidebarGlyph}" Text="&#xE943;"/><TextBlock Text="AI"/></StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="ProxyState" FontWeight="SemiBold" AutomationProperties.AutomationId="ProxyState">代理已停用</TextBlock>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="CurrentNode" Margin="0,4,0,0" Opacity="0.74" FontSize="12"
                                           TextWrapping="Wrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                <TextBlock x:Name="CurrentRouting" Margin="0,4,0,0" Opacity="0.74" FontSize="12"
                                           TextWrapping="Wrap" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Button x:Name="ToggleButton" Margin="0,11,0,0" Style="{DynamicResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Click="ToggleClick" AutomationProperties.AutomationId="ToggleProxy">开启代理</Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                      DragCompleted="SidebarDragCompleted" KeyUp="SidebarResizeKeyUp"
                      AutomationProperties.Name="调整侧栏宽度" AutomationProperties.AutomationId="SidebarSplitter"
                      AutomationProperties.HelpText="向左或向右拖动，或按左右方向键。">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Divider" Width="1" HorizontalAlignment="Center" SnapsToDevicePixels="True"
                                Background="{DynamicResource ButtonBorderBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Divider" Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
                            <Setter TargetName="Divider" Property="Width" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Divider" Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
                            <Setter TargetName="Divider" Property="Width" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Divider" Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
                            <Setter TargetName="Divider" Property="Width" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Column="2" Margin="24,22,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="NodesPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="节点" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="NodesTitle"/>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="AddNodeButton" Click="AddNodeClick" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="AddLocalNode">添加节点…</Button>
                        <Button x:Name="ScanButton" Click="ScanClick" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="ScanCode">扫码…</Button>
                        <Button x:Name="SubscriptionButton" Click="SubscriptionClick" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="AddSubscription">添加订阅…</Button>
                        <Button x:Name="ImportButton" Click="ImportClick" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="ImportNodes">导入 JSON</Button>
                        <Button x:Name="ProbeButton" Click="ProbeClick" Margin="0,0,8,6"
                                AutomationProperties.AutomationId="ProbeNodes">测试全部</Button>
                    </WrapPanel>
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <Label Content="节点组" Target="{Binding ElementName=GroupBox}" Padding="0,7,0,0" Margin="0,0,8,6"/>
                    <ComboBox x:Name="GroupBox" Width="223" DisplayMemberPath="Label" SelectionChanged="ScopeChanged"
                              ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.Label}"
                              AutomationProperties.AutomationId="NodeGroups" Margin="0,0,8,6"/>
                    <Button x:Name="NewGroupButton" Click="NewGroupClick" Margin="0,0,8,6"
                            AutomationProperties.AutomationId="NewNodeGroup">新建组…</Button>
                    <Button x:Name="RefreshGroupButton" Click="RefreshGroupClick" Margin="0,0,8,6"
                            AutomationProperties.AutomationId="RefreshGroup">刷新订阅</Button>
                    <Button x:Name="GroupSettingsButton" Click="GroupSettingsClick" Margin="0,0,8,6"
                            AutomationProperties.AutomationId="GroupSettings">组设置…</Button>
                    <Button x:Name="ShareGroupButton" Click="ShareGroupClick" Margin="0,0,0,6"
                            AutomationProperties.AutomationId="ShareGroup">分享组…</Button>
                </WrapPanel>
                <Border x:Name="SubscriptionInfoBar" Grid.Row="2" Style="{StaticResource PanelCard}"
                        Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SubscriptionSummary" TextWrapping="Wrap" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="SubscriptionSummary"/>
                        <TextBlock x:Name="SubscriptionUsage" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.75"
                                   AutomationProperties.AutomationId="SubscriptionUsage"/>
                    </StackPanel>
                </Border>
                <ListView x:Name="NodeList" Grid.Row="3" SelectionMode="Single"
                          AutomationProperties.Name="节点列表" AutomationProperties.AutomationId="NodeList"
                          AutomationProperties.HelpText="单击节点即可切换，也可选中节点后按 Enter。"
                          PreviewMouseLeftButtonUp="NodeLeftButtonUp" PreviewKeyDown="NodeKeyDown"
                          PreviewMouseRightButtonDown="NodeRightButtonDown" ContextMenuOpening="NodeMenuOpening"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="使用此节点" Click="SelectClick" AutomationProperties.AutomationId="UseSingleNode"/>
                            <MenuItem Header="测试此节点" Click="ProbeNodeClick" AutomationProperties.AutomationId="ProbeSingleNode"/>
                            <Separator/>
                            <MenuItem Header="查看与编辑…" Click="EditNodeClick" AutomationProperties.AutomationId="EditSingleNode"/>
                            <MenuItem Header="分享二维码…" Click="ShareNodeClick" AutomationProperties.AutomationId="ShareSingleNode"/>
                            <MenuItem Header="删除节点…" Click="DeleteNodeClick" AutomationProperties.AutomationId="DeleteSingleNode"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="名称" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,1" CornerRadius="4"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UseStatus}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UseStatus}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Node.Name}" ToolTip="{Binding Node.Name}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding GroupNames}" ToolTip="{Binding GroupNames}"
                                                       Margin="0,2,0,0" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListView}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="协议" DisplayMemberBinding="{Binding Protocol}" Width="116"/>
                            <GridViewColumn Header="HTTPS 探测" DisplayMemberBinding="{Binding Test}" Width="124"/>
                            <GridViewColumn Header="出口 IP / 地区" Width="206">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExitDisplay}" ToolTip="{Binding ExitDisplay}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="上次测试" Width="93">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TestAge}" ToolTip="{Binding TestLocalTime}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <ScrollViewer x:Name="ConfigPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="740" HorizontalAlignment="Left" Width="{Binding ViewportWidth, ElementName=ConfigPage}">
                    <TextBlock Text="配置" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="ConfigTitle"/>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="分流配置" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="RoutingSummary" Margin="0,6,0,10" Opacity="0.75" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RoutingSummary"/>
                            <WrapPanel>
                                <ComboBox x:Name="RoutingSelection" Width="250" DisplayMemberPath="Name"
                                          SelectionChanged="RoutingChoiceChanged" AutomationProperties.AutomationId="RoutingSelection"
                                          AutomationProperties.Name="分流配置列表" Margin="0,0,8,6"/>
                                <Button x:Name="ApplyRoutingChoice" Click="ApplyRoutingChoiceClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="ApplyRoutingChoice">切换</Button>
                                <Button x:Name="NewRoutingButton" Click="NewRoutingClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="NewRouting">新建…</Button>
                                <Button x:Name="EditRoutingButton" Click="EditRoutingClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="EditRouting">编辑…</Button>
                                <Button x:Name="DeleteRoutingButton" Click="DeleteRoutingClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="DeleteRouting">删除…</Button>
                                <Button x:Name="RefreshRoutingButton" Click="RefreshRoutingClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="RefreshRouting">刷新订阅</Button>
                                <Button x:Name="MigrateClashButton" Click="MigrateClashClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="MigrateClash">从 Clash 迁移…</Button>
                            </WrapPanel>
                            <Expander x:Name="RuleTestPanel" Header="测试规则" Margin="0,10,0,0"
                                      Expanded="RuleTestOpened" AutomationProperties.AutomationId="RuleTestPanel">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock x:Name="RuleTestTarget" TextWrapping="Wrap" Opacity="0.78"
                                               AutomationProperties.AutomationId="RuleTestTarget"/>
                                    <Label Content="域名或 IP" Target="{Binding ElementName=RuleTestHost}" Padding="0,12,0,5"/>
                                    <DockPanel>
                                        <Button x:Name="RuleTestButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                Style="{DynamicResource AccentButtonStyle}" Click="RuleTestClick"
                                                AutomationProperties.AutomationId="RunRuleTest">测试</Button>
                                        <TextBox x:Name="RuleTestHost" MaxLength="253" TextChanged="RuleTestHostChanged"
                                                 KeyDown="RuleTestHostKeyDown" AutomationProperties.AutomationId="RuleTestHost"/>
                                    </DockPanel>
                                    <Border x:Name="RuleTestResult" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="RuleResultPolicy" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="RuleResultPolicy"/>
                                            <TextBlock x:Name="RuleResultLocation" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="RuleResultText" FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="RuleResultText"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="RuleTestFeedback" Margin="0,8,0,0" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="RuleTestFeedback" AutomationProperties.LiveSetting="Polite"/>
                                    <Button x:Name="OpenRuleDraft" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Click="OpenRuleDraftClick" AutomationProperties.AutomationId="AddRoutingRule">添加规则…</Button>
                                    <Border x:Name="RuleDraft" Visibility="Collapsed" Margin="0,12,0,0" Padding="14"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <WrapPanel>
                                                <StackPanel Margin="0,0,14,8">
                                                    <Label Content="匹配类型" Target="{Binding ElementName=RuleDraftType}" Padding="0,0,0,5"/>
                                                    <ComboBox x:Name="RuleDraftType" Width="172" SelectionChanged="RuleDraftTypeChanged"
                                                              AutomationProperties.AutomationId="RuleDraftType">
                                                        <ComboBoxItem>DOMAIN-SUFFIX</ComboBoxItem>
                                                        <ComboBoxItem>DOMAIN</ComboBoxItem>
                                                        <ComboBoxItem>DOMAIN-KEYWORD</ComboBoxItem>
                                                        <ComboBoxItem>IP-CIDR</ComboBoxItem>
                                                        <ComboBoxItem>GEOIP</ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,8">
                                                    <Label Content="策略" Target="{Binding ElementName=RuleDraftPolicy}" Padding="0,0,0,5"/>
                                                    <ComboBox x:Name="RuleDraftPolicy" Width="116" AutomationProperties.AutomationId="RuleDraftPolicy">
                                                        <ComboBoxItem>PROXY</ComboBoxItem>
                                                        <ComboBoxItem>DIRECT</ComboBoxItem>
                                                        <ComboBoxItem>REJECT</ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>
                                            </WrapPanel>
                                            <Label x:Name="RuleDraftValueLabel" Content="匹配值" Target="{Binding ElementName=RuleDraftValue}"
                                                   Padding="0,0,0,5"/>
                                            <TextBox x:Name="RuleDraftValue" MaxLength="253" AutomationProperties.AutomationId="RuleDraftValue"/>
                                            <CheckBox x:Name="RuleDraftNoResolve" Content="不为这条规则解析域名（no-resolve）"
                                                      Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="RuleDraftNoResolve"/>
                                            <TextBlock Text="新规则放在 [Rule] 段首，保存后复测上方地址。" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="RuleDraftFeedback" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="RuleDraftFeedback" AutomationProperties.LiveSetting="Polite"/>
                                            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button Margin="0,0,8,0" Click="CancelRuleDraftClick">取消</Button>
                                                <Button x:Name="SaveRuleDraft" Click="SaveRuleDraftClick" Style="{DynamicResource AccentButtonStyle}"
                                                        AutomationProperties.AutomationId="SaveRuleDraft">保存并复测</Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="代理接管" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ConfigProxyStatus" Margin="0,7,0,0" Opacity="0.75"
                                       AutomationProperties.AutomationId="ConfigProxyStatus"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Label Content="接管方式" Target="{Binding ElementName=CaptureModeInput}" Padding="0,5,8,0"/>
                                <ComboBox x:Name="CaptureModeInput" Width="160" Margin="0,0,8,6"
                                          SelectionChanged="CaptureModeDraftChanged" AutomationProperties.AutomationId="CaptureMode">
                                    <ComboBoxItem>系统代理</ComboBoxItem>
                                    <ComboBoxItem>全流量（TUN）</ComboBoxItem>
                                    <ComboBoxItem>仅监听（手动代理）</ComboBoxItem>
                                </ComboBox>
                                <Button x:Name="ElevateForTunButton" Visibility="Collapsed" Margin="0,0,8,6"
                                        Click="ElevateForTunClick" AutomationProperties.AutomationId="ElevateForTun">以管理员身份重启…</Button>
                            </WrapPanel>
                            <TextBlock x:Name="TunHelp" Visibility="Collapsed" Opacity="0.75" TextWrapping="Wrap"
                                       Text="全流量模式通过虚拟网卡接管终端等应用的 TCP、UDP 和 DNS，局域网及 Tailscale 私网保持直连。"/>
                            <TextBlock x:Name="ManualProxyHelp" Visibility="Collapsed" Opacity="0.75" TextWrapping="Wrap"
                                       Text="将需要代理的应用指向下方的本机混合端口，支持 HTTP 和 TCP SOCKS5。"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Label Content="混合端口" Target="{Binding ElementName=MixedPortInput}" Padding="0,5,8,0"/>
                                <TextBox x:Name="MixedPortInput" Width="76" MaxLength="5" Margin="0,0,16,6"
                                         AutomationProperties.AutomationId="MixedPort"/>
                                <Label Content="路由模式" Target="{Binding ElementName=RoutingModeInput}" Padding="0,5,8,0"/>
                                <ComboBox x:Name="RoutingModeInput" Width="120" Margin="0,0,8,6"
                                          AutomationProperties.AutomationId="RoutingMode">
                                    <ComboBoxItem>规则</ComboBoxItem>
                                    <ComboBoxItem>全局</ComboBoxItem>
                                    <ComboBoxItem>直连</ComboBoxItem>
                                </ComboBox>
                                <Button x:Name="ApplyProxyEndpoint" Click="ApplyProxyEndpointClick" Margin="0,0,0,6"
                                        AutomationProperties.AutomationId="ApplyProxyEndpoint">应用</Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <Label Content="系统代理例外" Target="{Binding ElementName=BypassInput}" Padding="0" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,7,0,10" Opacity="0.75" TextWrapping="Wrap"
                                       Text="仅用于系统代理模式。每行一个，支持域名、IP 和 Windows 通配符，如 *.example.com、192.168.*。"/>
                            <TextBox x:Name="BypassInput" AcceptsReturn="True" Height="108" MaxLength="2048" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ProxyBypass"/>
                            <Button x:Name="SaveConfigButton" Click="SaveConfigClick" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="SaveProxyConfig">保存配置</Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PrivateNetworkPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="私网" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="PrivateStatus" Text="未配置" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PrivateAddress" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="PrivateToggle" Content="加入私网" Click="PrivateToggleClick" Margin="0,0,8,6"
                                Style="{DynamicResource AccentButtonStyle}"/>
                        <Button x:Name="PrivateTun" Content="启用全流量" Click="PrivateTunClick" Margin="0,0,8,6" Visibility="Collapsed"/>
                        <Button x:Name="PrivateAuthorize" Content="在浏览器授权" Click="PrivateAuthorizeClick" Margin="0,0,8,6" Visibility="Collapsed"/>
                        <Button Content="重新检查" Click="PrivateRefreshClick" Margin="0,0,8,6"/>
                        <Button x:Name="PrivateLeave" Content="退出私网" Click="PrivateLeaveClick" Visibility="Collapsed" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="其他设备" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <ListBox x:Name="PrivatePeers" DisplayMemberPath="ListLabel" MinHeight="110" MaxHeight="202"
                                     SelectionChanged="PrivatePeerChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="PrivatePeerName" Text="选择设备" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PrivatePeerAddress" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PrivateProbeResult" Margin="0,6,0,8" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button x:Name="PrivateProbe" Content="测试连接" Click="PrivateProbeClick" IsEnabled="False" Margin="0,0,8,6"/>
                                <Button x:Name="PrivateCopy" Content="复制地址" Click="PrivateCopyClick" IsEnabled="False" Margin="0,0,8,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <Expander x:Name="PrivateSettings" Header="私网和中继设置">
                        <StackPanel Margin="0,10,0,0">
                            <Label Content="协调服务" Target="{Binding ElementName=PrivateProvider}"/>
                            <ComboBox x:Name="PrivateProvider" SelectedIndex="0" MaxWidth="245" HorizontalAlignment="Left"
                                      SelectionChanged="PrivateProviderChanged">
                                <ComboBoxItem>自托管 Headscale</ComboBoxItem>
                                <ComboBoxItem>Tailscale 账号</ComboBoxItem>
                            </ComboBox>
                            <Label x:Name="PrivateControlLabel" Content="HTTPS 协调服务器" Target="{Binding ElementName=PrivateControl}"/>
                            <TextBox x:Name="PrivateControl" MaxLength="300" />
                            <Label Content="设备名（可选）" Target="{Binding ElementName=PrivateName}"/>
                            <TextBox x:Name="PrivateName" MaxLength="63"/>
                            <StackPanel x:Name="PrivateRelayModeForm" Visibility="Collapsed">
                                <Label Content="中继模式" Target="{Binding ElementName=PrivateRelayMode}"/>
                                <ComboBox x:Name="PrivateRelayMode" SelectedIndex="0" MaxWidth="245" HorizontalAlignment="Left"
                                          SelectionChanged="PrivateRelayModeChanged">
                                    <ComboBoxItem>跟随 Tailscale 配置</ComboBoxItem>
                                    <ComboBoxItem>严格匹配自定义中继</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="PrivateStrictRelays">
                                <Label Content="预期中继域名" Target="{Binding ElementName=PrivateRelays}"/>
                                <TextBox x:Name="PrivateRelays" MaxLength="4096"/>
                            </StackPanel>
                            <TextBlock x:Name="PrivateRelayHelp" Margin="0,6,0,7" Opacity="0.74" TextWrapping="Wrap"/>
                            <Expander x:Name="PrivateRelayAudit" Visibility="Collapsed" Margin="0,0,0,7">
                                <TextBlock x:Name="PrivateActualRelays" Margin="0,6,0,4" TextWrapping="Wrap"/>
                            </Expander>
                            <Label Content="允许访问本机的 TCP 端口（可选）" Target="{Binding ElementName=PrivateInboundPorts}"/>
                            <TextBox x:Name="PrivateInboundPorts" MaxLength="192"/>
                            <TextBlock Text="用逗号分隔，例如 22。留空时拒绝私网入站。" Opacity="0.74" TextWrapping="Wrap"/>
                            <Button Content="保存设置" Click="PrivateSaveClick" Margin="0,10,0,4" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PrivateKeyForm" Header="使用一次性入网密钥" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel Margin="0,8,0,0">
                            <PasswordBox x:Name="PrivateKey" MaxLength="4096" AutomationProperties.Name="一次性入网密钥"/>
                            <Button Content="使用密钥加入" Click="PrivateKeyClick" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="StatsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="870" HorizontalAlignment="Left" Width="{Binding ViewportWidth, ElementName=StatsPage}">
                    <StackPanel.Resources>
                        <Style x:Key="TrafficCaption" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Opacity" Value="0.75"/>
                        </Style>
                        <Style x:Key="TrafficPeriodOption" TargetType="RadioButton">
                            <Setter Property="Padding" Value="9,5"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Surface" Background="Transparent" CornerRadius="4"
                                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="统计" Style="{StaticResource PageTitle}" Margin="0,0,0,3" AutomationProperties.AutomationId="StatsTitle"/>
                    <TextBlock x:Name="TrafficScope" Margin="0,0,0,12" Style="{StaticResource TrafficCaption}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TrafficScope"/>
                    <Border Style="{StaticResource PanelCard}" Padding="14,10">
                        <UniformGrid Columns="4">
                            <TextBlock x:Name="TrafficStatus" Text="代理已停用" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" AutomationProperties.AutomationId="TrafficStatus"/>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="实时下载" Style="{StaticResource TrafficCaption}"/>
                                <TextBlock x:Name="DownloadSpeed" Text="—" FontSize="16" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="DownloadSpeed"/>
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="实时上传" Style="{StaticResource TrafficCaption}"/>
                                <TextBlock x:Name="UploadSpeed" Text="—" FontSize="16" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="UploadSpeed"/>
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="活跃连接" Style="{StaticResource TrafficCaption}"/>
                                <TextBlock x:Name="ConnectionCount" Text="—" FontSize="16" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="ActiveConnections"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="流量用量" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="2">
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource TrafficPeriodOption}" Content="今天" Tag="Today" IsChecked="True"
                                                     GroupName="TrafficPeriod" Checked="TrafficPeriodChanged" AutomationProperties.AutomationId="TrafficToday"/>
                                        <RadioButton Style="{StaticResource TrafficPeriodOption}" Content="昨天" Tag="Yesterday"
                                                     GroupName="TrafficPeriod" Checked="TrafficPeriodChanged" AutomationProperties.AutomationId="TrafficYesterday"/>
                                        <RadioButton Style="{StaticResource TrafficPeriodOption}" Content="近 7 天" Tag="Last7Days"
                                                     GroupName="TrafficPeriod" Checked="TrafficPeriodChanged" AutomationProperties.AutomationId="TrafficLast7Days"/>
                                        <RadioButton Style="{StaticResource TrafficPeriodOption}" Content="近 30 天" Tag="Last30Days"
                                                     GroupName="TrafficPeriod" Checked="TrafficPeriodChanged" AutomationProperties.AutomationId="TrafficLast30Days"/>
                                        <RadioButton Style="{StaticResource TrafficPeriodOption}" Content="全部" Tag="All"
                                                     GroupName="TrafficPeriod" Checked="TrafficPeriodChanged" AutomationProperties.AutomationId="TrafficAll"/>
                                    </WrapPanel>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="HistoryRange" Margin="0,7,0,0" Style="{StaticResource TrafficCaption}"
                                       TextWrapping="Wrap" AutomationProperties.AutomationId="TrafficHistoryRange"/>
                            <UniformGrid Columns="3" Margin="0,12,0,14">
                                <StackPanel>
                                    <TextBlock Text="累计用量" Style="{StaticResource TrafficCaption}"/>
                                    <TextBlock x:Name="HistoryTotal" Text="—" FontSize="25" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="TrafficHistoryTotal"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" CornerRadius="2" Margin="0,0,5,0"
                                                Background="{DynamicResource AccentButtonBackground}"/>
                                        <TextBlock Text="下载" Style="{StaticResource TrafficCaption}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HistoryDownload" Text="—" FontSize="23" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="TrafficHistoryDownload"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" CornerRadius="2" Margin="0,0,5,0" Background="#0E9383"/>
                                        <TextBlock Text="上传" Style="{StaticResource TrafficCaption}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HistoryUpload" Text="—" FontSize="23" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="TrafficHistoryUpload"/>
                                </StackPanel>
                            </UniformGrid>
                            <DockPanel>
                                <TextBlock x:Name="HistoryLegend" DockPanel.Dock="Right" Style="{StaticResource TrafficCaption}"/>
                                <TextBlock x:Name="HistoryGranularity" Style="{StaticResource TrafficCaption}"/>
                            </DockPanel>
                            <local:TrafficHistoryChart x:Name="HistoryChart" AutomationProperties.AutomationId="TrafficHistoryChart"/>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <UniformGrid Columns="4">
                                        <TextBlock x:Name="HistoryBinLabel" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" AutomationProperties.AutomationId="TrafficSelectedPeriod"/>
                                        <StackPanel Margin="6,0">
                                            <TextBlock Text="合计" Style="{StaticResource TrafficCaption}"/>
                                            <TextBlock x:Name="HistoryBinTotal" Text="—" FontWeight="SemiBold" AutomationProperties.AutomationId="TrafficSelectedTotal"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0">
                                            <TextBlock Text="下载" Style="{StaticResource TrafficCaption}"/>
                                            <TextBlock x:Name="HistoryBinDownload" Text="—" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="6,0">
                                            <TextBlock Text="上传" Style="{StaticResource TrafficCaption}"/>
                                            <TextBlock x:Name="HistoryBinUpload" Text="—" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="HistoryBinNote" Style="{StaticResource TrafficCaption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="HistoryNotice" Style="{StaticResource TrafficCaption}" Margin="0,9,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="TrafficHistoryNotice"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="12,8">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="实时连接" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Click="OpenConnectionsClick" Margin="0,0,8,0" AutomationProperties.AutomationId="OpenConnections">连接列表…</Button>
                                <Button Click="OpenEngineLogClick" AutomationProperties.AutomationId="OpenEngineLog">内核日志…</Button>
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="740" HorizontalAlignment="Left" Width="{Binding ViewportWidth, ElementName=SettingsPage}">
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="SettingsTitle"/>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="CloseToTray" Margin="0,10,0,0" Content="关闭窗口时收起到系统托盘"
                                      Checked="ClosePreferenceChanged" Unchecked="ClosePreferenceChanged"
                                      AutomationProperties.AutomationId="CloseToTray"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="登录启动" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="StartAtLoginInput" Content="登录 Windows 时启动 Byway" Margin="0,10,0,0"
                                      Click="StartupPreferenceChanged" AutomationProperties.AutomationId="StartAtLogin"/>
                            <CheckBox x:Name="ResumeProxyInput" Content="登录时恢复上次启用的代理" Margin="0,8,0,0"
                                      Click="StartupPreferenceChanged" AutomationProperties.AutomationId="ResumeProxy"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,12,0,0">
                        <DockPanel>
                            <Button Click="OpenDataFolderClick" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right"
                                    AutomationProperties.AutomationId="OpenDataFolder">打开数据文件夹</Button>
                            <StackPanel>
                                <TextBlock Text="Byway" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="VersionLabel" Margin="0,6,0,0" Opacity="0.75"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AiPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="740" HorizontalAlignment="Left" Width="{Binding ViewportWidth, ElementName=AiPage}">
                    <TextBlock Text="AI" Style="{StaticResource PageTitle}" AutomationProperties.AutomationId="AiTitle"/>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="当前设备" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="AiDeviceName" Margin="0,9,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AiDeviceName"/>
                            <TextBlock x:Name="AiDeviceCode" Margin="0,4,0,0" Opacity="0.76"
                                       AutomationProperties.AutomationId="AiDeviceCode"/>
                            <Button x:Name="AiRenameDevice" Content="修改设备名称" Margin="0,9,0,0" HorizontalAlignment="Left"
                                    Click="EditDeviceNameClick" AutomationProperties.AutomationId="AiRenameDevice"/>
                            <StackPanel x:Name="AiDeviceNameEditor" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBox x:Name="AiDeviceNameInput" AutomationProperties.Name="设备名称"
                                         AutomationProperties.AutomationId="AiDeviceNameInput"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="保存" Style="{DynamicResource AccentButtonStyle}"
                                            Click="SaveDeviceNameClick" Margin="0,0,8,0"
                                            AutomationProperties.AutomationId="AiSaveDeviceName"/>
                                    <Button Content="取消" Click="CancelDeviceNameClick"/>
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock x:Name="AiDeviceFeedback" Margin="0,8,0,0" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="API 连接" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="AiLocalAddress" Margin="0,9,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AiLocalAddress"/>
                            <CheckBox x:Name="AiLanToggle" Content="允许局域网控制" Margin="0,15,0,0"
                                      Click="AiLanChanged" AutomationProperties.AutomationId="AiLanToggle"/>
                            <TextBlock x:Name="AiLanAddress" Margin="0,6,0,0" Opacity="0.76" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AiLanAddress"/>
                            <CheckBox x:Name="AiDiscoveryToggle" Margin="0,12,0,0" Content="允许局域网发现"
                                      Click="ChangeDiscoveryClick" AutomationProperties.AutomationId="AiDiscoveryToggle"/>
                            <TextBlock x:Name="AiDiscoveryStatus" Margin="0,5,0,0" TextWrapping="Wrap" Opacity="0.76"/>
                            <TextBlock x:Name="AiWebAddress" Margin="0,12,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AiWebAddress"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="AiOpenWeb" Click="OpenManagementClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="AiOpenWeb">打开管理网页</Button>
                                <Button x:Name="AiCopyWeb" Click="CopyManagementClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="AiCopyWeb">复制网页链接</Button>
                                <Button x:Name="AiCopyWebIp" Click="CopyManagementIpClick" Margin="0,0,8,6" Visibility="Collapsed"
                                        AutomationProperties.AutomationId="AiCopyWebIp">复制 IP 链接</Button>
                            </WrapPanel>
                            <TextBlock x:Name="AiFeedback" Margin="0,8,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="AiFeedback" AutomationProperties.LiveSetting="Polite"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="AiCopyConnection" Click="CopyAiConnectionClick"
                                        Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="AiCopyConnection">复制 AI 接入指令</Button>
                                <Button Click="RotateAiTokenClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="AiRotateToken">更换访问令牌…</Button>
                                <Button Click="ShowAiLogClick" Margin="0,0,8,6"
                                        AutomationProperties.AutomationId="AiLogButton">调用日志…</Button>
                                <Button x:Name="AiRetry" Click="RetryAiClick" Visibility="Collapsed" Margin="0,0,8,6">重试启动</Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="1" x:Name="Status" Margin="0,10,0,0" MinHeight="20" TextWrapping="Wrap" Opacity="0.8"
                       AutomationProperties.AutomationId="OperationStatus" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>
