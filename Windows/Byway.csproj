<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>Byway.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Byway.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.16.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Localization/byway-*.json" LogicalName="Byway.Localization.%(Filename)%(Extension)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../Shared/Web/management.html" LogicalName="Byway.Web.management.html" />
    <EmbeddedResource Include="../Shared/Web/management.css" LogicalName="Byway.Web.management.css" />
    <EmbeddedResource Include="../Shared/Web/management.js" LogicalName="Byway.Web.management.js" />
    <EmbeddedResource Include="AI-GUIDE.md" LogicalName="Byway.AI-GUIDE.md" />
    <EmbeddedResource Include="Skills/byway-control/SKILL.md" LogicalName="Byway.AI-SKILL.md" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <Resource Include="Byway.ico" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ZXing.Net.LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Update="YamlDotNet.LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Tunnel/Resources/geoip-cn.srs;../Tunnel/Resources/GeoIP-NOTICE.txt" Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
