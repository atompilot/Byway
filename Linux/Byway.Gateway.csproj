<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Localization/byway-*.json" LogicalName="Byway.Localization.%(Filename)%(Extension)" />
    <Compile Include="../Windows/L10n.cs" Link="L10n.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../Shared/Web/management.html" LogicalName="Byway.Web.management.html" />
    <EmbeddedResource Include="../Shared/Web/management.css" LogicalName="Byway.Web.management.css" />
    <EmbeddedResource Include="../Shared/Web/management.js" LogicalName="Byway.Web.management.js" />
    <Compile Include="../Windows/ManagementPage.cs" Link="ManagementPage.cs" />
    <Compile Include="../Windows/DeviceIdentity.cs" Link="DeviceIdentity.cs" />
    <Compile Include="../Windows/DiscoveryState.cs" Link="DiscoveryState.cs" />
    <Compile Include="../Windows/NodeImport.cs" Link="NodeImport.cs" />
  </ItemGroup>
</Project>
